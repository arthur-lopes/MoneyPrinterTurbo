[Unit]
Description=MoneyPrinterTurbo supervised production workspace
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=moneyprinter
Group=moneyprinter
WorkingDirectory=/var/lib/moneyprinter
EnvironmentFile=/etc/moneyprinter/service.env
Environment=HOME=/var/lib/moneyprinter
Environment=CODEX_HOME=/var/lib/moneyprinter/codex
Environment=MPT_HOME=/var/lib/moneyprinter
Environment=MPT_PRODUCTION_CODEX_BINARY=/opt/moneyprinter/codex/bin/codex
Environment=MPT_PRODUCTION_DRAIN_LOCK=/opt/moneyprinter/deployment/drain.lock
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/moneyprinter/bin/run-production
Restart=on-failure
RestartSec=4
TimeoutStopSec=20
Nice=5
CPUWeight=25
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moneyprinter

[Install]
WantedBy=multi-user.target
